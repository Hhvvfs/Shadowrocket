#!name = YouTube 去广告（Egern）
#!desc = 去广告 + 后台播放（Egern 可用）
#!author = Maasea（Egern 改写）
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png


[Rule]
DOMAIN-SUFFIX,googlevideo.com,REJECT
DOMAIN,youtubei.googleapis.com,REJECT


[Script]
youtube.response = http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|get_watch|guide|account\/get_setting) \
script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js \
requires-body=true \
binary-body-mode=true \
timeout=30


[MITM]
hostname = *.googlevideo.com,www.youtube.com,s.youtube.com,youtubei.googleapis.com
